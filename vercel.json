{
  "functions": {
    "api/sync-sales.js": { "maxDuration": 60 },
    "api/check-attendance-alerts.js": { "maxDuration": 30 },
    "api/tossplace-bootstrap-connection.js": { "maxDuration": 20 },
    "api/tossplace-custom-credentials.js": { "maxDuration": 20 },
    "api/organization-sales-dashboard.js": { "maxDuration": 20 },
    "api/send-settlement-email.js": { "maxDuration": 20 },
    "api/staff-sensitive-profile.js": { "maxDuration": 20 },
    "api/payroll-notifications.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/sync-sales", "schedule": "0 13 * * *" },
    { "path": "/api/check-attendance-alerts", "schedule": "0 0 * * *" },
    { "path": "/api/payroll-notifications", "schedule": "0 1 * * *" }
  ],
  "rewrites": [
    { "source": "/tablet", "destination": "/index.html" },
    { "source": "/sales", "destination": "/sales.html" }
  ]
}
