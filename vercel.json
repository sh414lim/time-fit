{
  "functions": {
    "api/[...route].js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/sync-sales", "schedule": "0 13 * * *" },
    { "path": "/api/check-attendance-alerts", "schedule": "0 0 * * *" },
    { "path": "/api/payroll-notifications", "schedule": "0 1 * * *" },
    { "path": "/api/card-sync-worker", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    { "source": "/tablet", "destination": "/index.html" },
    { "source": "/sales", "destination": "/sales.html" }
  ]
}
